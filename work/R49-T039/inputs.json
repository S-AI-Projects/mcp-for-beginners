{
  "contract_test_cases": [
    {
      "id": 1,
      "tool": "add",
      "params": {"a": 2, "b": 3},
      "expected_result": {"value": 5, "tool": "add"}
    },
    {
      "id": 2,
      "tool": "multiply",
      "params": {"a": 2, "b": 3},
      "expected_result": {"value": 6, "tool": "multiply"}
